# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV="development"
HOST="0.0.0.0"
PORT="3005"
# fatal | error | warn | info | debug | trace | silent
WHATSAPP_LOG_LEVEL="info"
# Very noisy; only raise while debugging the Baileys protocol itself.
WHATSAPP_BAILEYS_LOG_LEVEL="silent"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Shared secret for API clients and outbound webhooks. Leave empty in
# production to generate a strong key on first boot; copy it from
# /console/api-keys. It is persisted beside the database in
# bootstrap-api-key. Generate manually with: openssl rand -hex 32
WHATSAPP_API_KEY=""

# ---------------------------------------------------------------------------
# Persistent state (a volume in production)
# ---------------------------------------------------------------------------
# One SQLite file holds settings, API keys, console admins/sessions, the
# outbox, WhatsApp credentials and the audit log. Back it up.
WHATSAPP_DATABASE_PATH=""
# Attachment bytes stay on disk; their metadata is in SQLite.
WHATSAPP_MEDIA_DIR=""
# Inbound attachment spool: retention and total-byte cap.
WHATSAPP_MEDIA_TTL_MS="86400000"
WHATSAPP_MEDIA_MAX_BYTES="536870912"
# Largest attachment the engine downloads; larger files forward metadata only.
WHATSAPP_INBOUND_MEDIA_MAX_BYTES="16777216"

# ---------------------------------------------------------------------------
# Admin console at /console
# ---------------------------------------------------------------------------
WHATSAPP_CONSOLE_ENABLED="true"
# Used only to create the first admin when the database has none. Leave both
# empty to create the admin at /console/setup after installation. After that,
# manage the account (and change the password) inside the console.
WHATSAPP_CONSOLE_EMAIL=""
WHATSAPP_CONSOLE_PASSWORD=""
WHATSAPP_CONSOLE_SESSION_HOURS="168"
# Public console origin. Derived from WHATSAPP_DOMAIN when unset. Set this if a
# reverse proxy rewrites Host and login says "Cross-site request refused".
WHATSAPP_CONSOLE_URL=""

# ---------------------------------------------------------------------------
# Session lifecycle
# ---------------------------------------------------------------------------
WHATSAPP_RESTORE="true"
WHATSAPP_RESTORE_DELAY_MS="1500"
WHATSAPP_PAIRING_TIMEOUT_MS="180000"

# ---------------------------------------------------------------------------
# Callbacks (optional)
# ---------------------------------------------------------------------------
# Inbound messages: full template with {sessionId}, or a base origin. When a
# base origin is given, /store/{sessionId}/whatsapp is appended.
WHATSAPP_INBOUND_URL=""
WHATSAPP_INBOUND_TIMEOUT_MS="3000"
# Send-status outcomes. Defaults to the inbound URL's sibling; set explicitly
# only when the two live on different hosts.
WHATSAPP_STATUS_URL=""
WHATSAPP_STATUS_TIMEOUT_MS="3000"

# ---------------------------------------------------------------------------
# Outbound pacing and retries
# ---------------------------------------------------------------------------
WHATSAPP_SEND_GAP_MS="3000"
WHATSAPP_SEND_JITTER_MS="2000"
WHATSAPP_HOURLY_CAP="120"
WHATSAPP_OUTBOX_MAX_AGE_MS="86400000"
WHATSAPP_OUTBOX_MAX_ATTEMPTS="8"

# ---------------------------------------------------------------------------
# Human-looking "typing…" before chatbot replies
# ---------------------------------------------------------------------------
WHATSAPP_TYPING="true"
WHATSAPP_TYPING_MIN_MS="1200"
WHATSAPP_TYPING_MAX_MS="8000"
WHATSAPP_TYPING_MS_PER_CHAR="35"
WHATSAPP_TYPING_JITTER_RATIO="0.2"

# ---------------------------------------------------------------------------
# Docker Compose only: the public hostname Caddy gets a certificate for.
# ---------------------------------------------------------------------------
# WHATSAPP_DOMAIN="whatsapp.example.com"

# ---------------------------------------------------------------------------
# Docker Compose only: pin a published image instead of building locally.
# ---------------------------------------------------------------------------
# WA_GATEWAY_IMAGE="ghcr.io/ridhotamma/wa-gateway:1.0.0"
