{
  "name": "wa-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Standalone WhatsApp gateway: Baileys transport, SQLite outbox and a Hono REST API with a Polaris-style console.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "backup": "node dist/cli/backup.js",
    "console:admin": "node dist/cli/console-admin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,yml,yaml}\""
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hono/node-server": "^2.1.6",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.5",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
