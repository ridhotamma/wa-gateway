{
  "name": "wa-gateway",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Standalone WhatsApp gateway: Baileys transport, SQLite outbox, a Hono REST API with a generated OpenAPI reference, and a Polaris-style console.",
  "keywords": [
    "whatsapp",
    "whatsapp-api",
    "whatsapp-gateway",
    "baileys",
    "hono",
    "sqlite",
    "outbox",
    "qr-code",
    "rest-api",
    "openapi",
    "scalar",
    "self-hosted",
    "typescript",
    "docker"
  ],
  "homepage": "https://github.com/ridhotamma/wa-gateway#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridhotamma/wa-gateway.git"
  },
  "bugs": {
    "url": "https://github.com/ridhotamma/wa-gateway/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "backup": "node dist/cli/backup.js",
    "console:admin": "node dist/cli/console-admin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md,yml,yaml}\""
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.19",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/qrcode": "^1.5.5",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
